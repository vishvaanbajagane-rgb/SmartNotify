# Copy this file to .env and fill in real values. Never commit .env itself.

ENV=development
CORS_ORIGINS=http://localhost:3000

# Local docker-compose Postgres (matches docker-compose.yml below)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/smartnotify

DATASET_PATH=dataset/messages.csv
OUTPUT_PATH=output/output.csv
ML_MODELS_DIR=ml_models

SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
WHISPER_MODEL_SIZE=base
FAISS_INDEX_PATH=ml_models/faiss_index.bin

# Optional — only needed if you opt into paid alternatives (see README section 8)
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

NOTIFY_CONFIDENCE_THRESHOLD=0.65
SCAM_BLOCK_THRESHOLD=0.75

# --- Authentication (JWT) ---
# Generate a real secret for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit a real secret — this default is fine for local dev only.
JWT_SECRET_KEY=change-this-in-production-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440