# Copy this file to .env and fill in real values. Never commit .env itself.

ENV=development
CORS_ORIGINS=http://localhost:3000

# Local docker-compose Postgres (matches docker-compose.yml below)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/smartnotify

DATASET_PATH=dataset/messages.csv
OUTPUT_PATH=output/output.csv
ML_MODELS_DIR=ml_models

SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
WHISPER_MODEL_SIZE=base
FAISS_INDEX_PATH=ml_models/faiss_index.bin

# Optional — only needed if you opt into paid alternatives (see README section 5)
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

NOTIFY_CONFIDENCE_THRESHOLD=0.65
SCAM_BLOCK_THRESHOLD=0.75
